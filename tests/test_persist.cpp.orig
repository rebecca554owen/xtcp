/**
 * @file test_persist.cpp
 * @brief RFC 1122 zero-window persist: when the peer advertises a zero
 *        window, buffered sends arm a probe timer; the probe (1 byte)
 *        forces the peer to re-advertise its window, so a lost
 *        window-update ACK cannot deadlock the flow. Window recovery
 *        flushes the buffered data.
 */

#include <xtcp/core/tcp.h>
#include <xtcp/buf/bufref.h>
#include <xtcp/cc/cc.h>

#include <cstdio>
#include <cstring>
#include <memory>
#include <vector>
#include <algorithm>

static int g_failures = 0;

#define CHECK(cond)                                                       \
    do {                                                                  \
        if (!(cond)) {                                                    \
            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
            ++g_failures;                                                 \
        }                                                                \
    } while (0)

namespace {
    using xtcp::core::TcpConn;
    using xtcp::core::TcpState;
    using xtcp::core::kFlagAck;

    struct TxLog {
        std::vector<UInt32> lens;
        std::vector<UInt16> flags;
        void Clear() {
            lens.clear();
            flags.clear();
        }
    };

    void PersistPacedInit(xtcp::cc::XtcpConnCc* sk) noexcept {
        sk->pacing_rate = 1000000000;
    }

    const xtcp::cc::XtcpCongestionOps kPersistPaced = {
        "persist_paced", PersistPacedInit, NULLPTR, NULLPTR, NULLPTR, NULLPTR,
        NULLPTR, NULLPTR, NULLPTR, NULLPTR, NULLPTR, 0,
    };

    std::unique_ptr<xtcp::core::TcpConn> MakeConn(TxLog& log) {
        static UInt32 g_iss = 0x40000000;
        ++g_iss;
        // Established: local 10.1.0.2:443, remote 10.1.0.1:40000.
        xtcp::core::Endpoint local;
        local.family = 4;
        local.addr[0] = 0x0A010002;
        local.port = 443;
        xtcp::core::Endpoint remote;
        remote.family = 4;
        remote.addr[0] = 0x0A010001;
        remote.port = 40000;
        return std::make_unique<xtcp::core::TcpConn>(
            TcpState::kEstablished, local, remote, g_iss, 200, [&log](xtcp::buf::BufRef&& p) {
                log.lens.push_back(p.Len());
                // flags byte at tcp offset 13 (IPv4 20B + TCP 13).
                const Byte* d = p.Data();
                log.flags.push_back(static_cast<UInt16>(d[20 + 13] & 0x3F));
            });
    }

    /** Builds a pure ACK segment (TCP only, no IP header - OnSegment takes
     *  raw TCP segments) with the given seq/ack/window. A real peer's
     *  window-recovery ACK rides a segment newer than the zero-window ACK
     *  (RFC 793 SND.WL), so the seq must be settable here. */
    std::vector<Byte> BuildAck(UInt32 ack, UInt32 window, UInt32 seq = 0) {
        std::vector<Byte> out(20, 0);
        out[0] = 0x9C; out[1] = 0x40;  // sport 40000
        out[2] = 0x01; out[3] = 0xBB;  // dport 443
        out[4] = static_cast<Byte>(seq >> 24); out[5] = static_cast<Byte>(seq >> 16);
        out[6] = static_cast<Byte>(seq >> 8);  out[7] = static_cast<Byte>(seq & 0xFF);
        out[8] = static_cast<Byte>(ack >> 24); out[9] = static_cast<Byte>(ack >> 16);
        out[10] = static_cast<Byte>(ack >> 8);  out[11] = static_cast<Byte>(ack & 0xFF);
        out[12] = 0x50; out[13] = 0x10;  // ACK, hdr len 20
        out[14] = static_cast<Byte>(window >> 8); out[15] = static_cast<Byte>(window & 0xFF);
        return out;
    }
}

static void TestZeroWindowProbe() {
    TxLog log;
    auto conn = MakeConn(log);
    CHECK(conn->SetCongestionControl("persist_paced"));
    conn->SetPersistInterval(1000);  // 1 ms probes for the test

    // Peer advertises window 0.
    const std::vector<Byte> ack0 = BuildAck(201, 0);
    conn->OnSegment(ack0.data(), static_cast<UInt32>(ack0.size()), 1000);
    CHECK(0 == conn->SndWnd());

    // Send buffers while the window is zero; a probe deadline is armed.
    Byte data[100];
    std::memset(data, 0xAB, sizeof(data));
    CHECK(conn->SendData(data, 100, 2000));
    CHECK(0 != conn->PersistDeadline());
    // A closed peer window cannot make progress at the pacing deadline. The
    // host must sleep until persist/RTO work instead of busy-polling and
    // starving a colocated receiver that needs CPU to reopen the window.
    CHECK(conn->NextTimerDeadline() == conn->PersistDeadline());
    CHECK(100 == conn->PendingSendBytes());
    CHECK(0 == log.lens.size());  // nothing sent yet

    // Persist timer fires: a 1-byte probe goes out (fire-and-forget).
    conn->OnPersistTimer(3000);
    CHECK(1 == log.lens.size());
    const UInt32 probe_len = log.lens[0];
    std::fprintf(stderr, "[persist] probe len=%u\n", probe_len);
    CHECK(40 < probe_len);  // IP + TCP + 1 byte payload
    log.Clear();

    // Peer still zero: another probe after backoff. The FIRST probe's byte is
    // now unacked (it sits in retrans_queue_), so the second probe RE-PROBES
    // that same byte (RFC 1122: probe the first UNACKED byte, the receiver's
    // gap - probing a fresh pending byte past the gap arrives out-of-order
    // and never reopens the window). No new byte is consumed from
    // pending_send_.
    conn->OnPersistTimer(6000);
    CHECK(1 == log.lens.size());

    // Window recovers: ACK with window 1000 flushes the buffered 100 bytes.
    // The recovery ACK rides a NEW segment (seq=1 > snd_wl2_=0): a real peer
    // answering the zero-window probes advances seq, so this passes the RFC
    // 793 SND.WL guard that rejected the stale duplicate below.
    log.Clear();  // probes verified above; count only the flushed data
    const std::vector<Byte> ack1 = BuildAck(201, 1000, 1);
    conn->OnSegment(ack1.data(), static_cast<UInt32>(ack1.size()), 7000);
    CHECK(0 == conn->PendingSendBytes());
    CHECK(0 == conn->PersistDeadline());  // probing stopped
    // The 100 buffered bytes went out (as one or more data segments).
    // RFC 1122: the first probe carried ONE real data byte (consumed from
    // the front of the buffer), so the recovery flush sends the remaining 99.
    UInt32 payload_total = 0;
    for (size_t i = 0; i < log.lens.size(); ++i) {
        payload_total += log.lens[i] - 40;
    }
    std::fprintf(stderr, "[persist] flushed bytes=%u\n", payload_total);
    CHECK(99 == payload_total);
    CHECK(0 == conn->PendingSendBytes());  // the probe byte is gone too
}

static void TestPersistIntervalPreservedAcrossRecovery() {
    // Regression pin for the persist_base_ fix: the user-configured probe
    // interval must survive a window-recovery episode (the three recovery
    // paths used to hardcode persist_interval_ = 1000000, permanently
    // replacing a user-set interval like 20 ms with the 1 s default).
    TxLog log;
    auto conn = MakeConn(log);
    conn->SetPersistInterval(20000);  // user base: 20 ms

    // Peer advertises window 0; buffering arms a probe at now + 20 ms.
    const std::vector<Byte> ack0 = BuildAck(201, 0);
    conn->OnSegment(ack0.data(), static_cast<UInt32>(ack0.size()), 1000);
    CHECK(0 == conn->SndWnd());
    Byte data[100];
    std::memset(data, 0xCD, sizeof(data));
    CHECK(conn->SendData(data, 100, 2000));
    CHECK(0 != conn->PersistDeadline());
    CHECK(20000 == conn->PersistDeadline() - 2000);  // armed at user base

    // The probe fires; backoff doubles the current interval to 40 ms.
    conn->OnPersistTimer(3000);
    CHECK(0 != conn->PersistDeadline());

    // Window recovers: the probe interval must reset to the USER base
    // (20 ms), not the backoff value (40 ms) and not the old hardcode (1 s).
    const std::vector<Byte> ack1 = BuildAck(201, 1000, 1);
    conn->OnSegment(ack1.data(), static_cast<UInt32>(ack1.size()), 4000);
    CHECK(0 == conn->PersistDeadline());

    // Peer goes zero again; a fresh buffer must arm at the user base.
    const std::vector<Byte> ack2 = BuildAck(201, 0, 2);
    conn->OnSegment(ack2.data(), static_cast<UInt32>(ack2.size()), 5000);
    CHECK(0 == conn->SndWnd());
    CHECK(conn->SendData(data, 100, 6000));
    CHECK(0 != conn->PersistDeadline());
    CHECK(20000 == conn->PersistDeadline() - 6000);  // user base preserved
}

static void TestLostProbeByteRecoverable() {
    // Regression pin: the persist probe carries a REAL data byte (consumed
    // from pending_send_) - it must be queued in retrans_queue_ so a probe
    // LOST on the wire is retransmitted by the RTO path. Before the fix the
    // probe was fire-and-forget: a lost probe permanently deleted that byte
    // from the stream (peer stalls at the gap, the recovery flush starts
    // past it, kMaxDataRetries kills the connection).
    TxLog log;
    auto conn = MakeConn(log);
    conn->SetPersistInterval(1000);

    // Peer advertises window 0; 100 bytes buffer behind the zero window.
    const std::vector<Byte> ack0 = BuildAck(201, 0);
    conn->OnSegment(ack0.data(), static_cast<UInt32>(ack0.size()), 1000);
    CHECK(0 == conn->SndWnd());
    Byte data[100];
    std::memset(data, 0xCD, sizeof(data));
    CHECK(conn->SendData(data, 100, 2000));
    CHECK(0 != conn->PersistDeadline());
    const UInt32 base_seq = conn->SndNxt();

    // Probe 1 fires: one real data byte (0xCD) leaves on the wire. The byte
    // must be queued (recoverable), so the retransmit queue front is the
    // probe's own sequence.
    conn->OnPersistTimer(3000);
    CHECK(1 == log.lens.size());
    CHECK(base_seq == conn->FrontSeq());  // queued at its seq (fix pin)
    log.Clear();

    // Probe 2 fires after backoff: another queued byte.
    conn->OnPersistTimer(6000);
    CHECK(1 == log.lens.size());
    CHECK(base_seq == conn->FrontSeq());  // probe 1 still queued ahead
    log.Clear();

    // Window recovers: the flush sends the remaining 98 bytes.
    const std::vector<Byte> ack1 = BuildAck(201, 1000, 1);
    conn->OnSegment(ack1.data(), static_cast<UInt32>(ack1.size()), 7000);
    CHECK(0 == conn->PersistDeadline());
    // The queue front is STILL the first probe byte (seq base_seq): the two
    // probe bytes were never ACKed (they were "lost"), so they must remain
    // retransmittable - not dropped, not skipped past.
    CHECK(base_seq == conn->FrontSeq());
    log.Clear();  // drop the recovery flush segments; count the RTO only

    // RTO fires: the first probe byte is retransmitted (full segment, same
    // payload byte 0xCD, same seq base_seq).
    const UInt64 rto_at = conn->NextRetransmitTime();
    CHECK(0 != rto_at);
    conn->OnRetransmitTimer(rto_at);
    CHECK(1 == log.lens.size());
    UInt32 payload_total = 0;
    for (size_t i = 0; i < log.lens.size(); ++i) {
        payload_total += log.lens[i] - 40;
    }
    CHECK(1 == payload_total);  // exactly the probe byte retransmitted
    std::fprintf(stderr, "[persist] lost probe byte recovered via RTO\n");
}

int main() {
    xtcp::buf::InitPools();
    CHECK(xtcp::cc::RegisterCongestionControl(kPersistPaced));
    TestZeroWindowProbe();
    TestPersistIntervalPreservedAcrossRecovery();
    TestLostProbeByteRecoverable();
    xtcp::buf::ShutdownPools();
    std::fprintf(stderr, g_failures ? "PERSIST: FAILED (%d)\n" : "PERSIST: ALL PASSED\n", g_failures);
    return g_failures ? 1 : 0;
}

